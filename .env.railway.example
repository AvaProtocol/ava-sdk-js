# Targets the deployed Railway/production gateway for the v4 REST suite.
#
# Usage:
#   cp .env.railway.example .env.railway
#   # fill in the placeholders below
#   TEST_ENV=railway yarn test
#
# The renovated multi-chain gateway routes per-part chains itself, so a
# single endpoint serves every supported chain — no per-chain env files.

# Public REST endpoint (production gateway). Full /api/v1 base path.
AVS_REST_URL=https://api.avaprotocol.org/api/v1

# Test EOA private key — no funds needed; used only for the EIP-191
# signature auth flow (client.auth.exchangeWithKey). This is the only
# auth the suite uses; no pre-minted API key is required.
TEST_PRIVATE_KEY=<REPLACE-WITH-TEST-EOA-PRIVATE-KEY>

# Partner assertion (Ed25519) for partner-gated reads (GET /tokens/*).
# Must match gateway partners[].public_keys and partner_assertion_audience.
# Production: audience is avs-gateway-prod; the private key is the dedicated
# `sdk-ci` partner's (avs-infra gateway config partners[sdk-ci], scopes `read`
# and `auth:exchange`), never Studio's. Production also requires the
# assertion on auth:exchange, so the suite cannot authenticate without it.
# PARTNER_ASSERTION_PRIVATE_KEY=<base64-ed25519-pkcs8-pem>
# PARTNER_ASSERTION_ISSUER=sdk-ci
# PARTNER_ASSERTION_AUDIENCE=avs-gateway-prod

# Sepolia RPC for block-trigger seeds and receipt polling. It must serve
# chain 11155111: tests/utils/client.ts verifies the chain id once and
# refuses anything else.
CHAIN_ENDPOINT=<REPLACE-WITH-CHAIN-RPC-URL>
